{
  "author": "Justin Wilaby",
  "name": "svg-path-interpolator",
  "version": "0.4.0",
  "license": "MIT",
  "description": "The SVG Path Interpolator produces point data representing interpolated values within an SVG path.",
  "repository": {
    "type": "git",
    "url": "https://github.com/justinwilaby/svg-path-interpolator.git"
  },
  "bin": {
    "svgpi": "./lib/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./*": "./lib/*"
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "browser": "./lib/index.js",
  "files": [
    "config",
    "lib",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "svg",
    "points",
    "paths",
    "drawing",
    "interpolate",
    "calculate",
    "animate",
    "bézier",
    "bezier",
    "curves",
    "polygon"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test",
    "test:coverage": "npm run build && node --test --experimental-test-coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "sax-wasm": "3.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
